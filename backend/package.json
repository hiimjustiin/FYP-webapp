{
    "name": "ila-backend",
    "version": "1.0.0",
    "description": "Backend API for Interdisciplinary Learning Analytics webapp",
    "main": "dist/server.js",
    "type": "module",
    "scripts": {
        "start": "node dist/server.js",
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "db:migrate": "tsx src/utils/migrate.ts",
        "db:migrate:down": "tsx src/utils/migrate.ts down",
        "db:migrate:create": "node-pg-migrate create --migrations-dir ./migrations",
        "db:seed": "tsx src/utils/seed.ts"
    },
    "dependencies": {
        "express": "^4.18.2",
        "cors": "^2.8.5",
        "helmet": "^7.1.0",
        "bcryptjs": "^2.4.3",
        "jsonwebtoken": "^9.0.2",
        "pg": "^8.11.3",
        "dotenv": "^16.3.1",
        "express-rate-limit": "^7.1.5",
        "express-validator": "^7.0.1",
        "morgan": "^1.10.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/cors": "^2.8.17",
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/pg": "^8.10.9",
        "@types/morgan": "^1.9.9",
        "@types/node": "^20.10.0",
        "node-pg-migrate": "^7.0.0",
        "tsx": "^4.6.2",
        "typescript": "^5.3.3"
    },
    "keywords": [
        "interdisciplinary",
        "learning",
        "analytics",
        "education",
        "api"
    ],
    "author": "ILA Team",
    "license": "MIT"
}