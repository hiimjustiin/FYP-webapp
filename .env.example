# Database Configuration
POSTGRES_DB=ila_db
POSTGRES_USER=ila_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_PORT=5432

# Application Configuration
NODE_ENV=development
JWT_SECRET=change-this-secret-key
# CORS_ORIGIN supports multiple origins separated by comma
# Development (Vite): http://localhost:5173
# Production (Docker): http://localhost:3000 or your domain
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
BACKEND_PUBLIC_URL=http://localhost:3001
FRONTEND_BASE_URL=http://localhost:5173

# Port Configuration
FRONTEND_PORT=3000
BACKEND_PORT=3001
AI_SERVICE_PORT=8000

# AI Service Configuration (Python FastAPI)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=2000
OPENAI_TIMEOUT=60
MAX_INPUT_TOKENS=10000

# AI Service Workers and Processing
AI_WORKERS=4
MAX_RETRIES=3
RETRY_DELAY=5
PROCESSING_TIMEOUT=300

# AI Cost Tracking (GPT-4o pricing)
COST_PER_1K_INPUT_TOKENS=0.0025
COST_PER_1K_OUTPUT_TOKENS=0.01

# Cache Configuration (Optional - Redis)
# REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=false
CACHE_TTL=86400

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# Express Backend Integration
EXPRESS_API_TIMEOUT=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# pgAdmin Configuration (Optional)
PGADMIN_EMAIL=admin@ila.com
PGADMIN_PASSWORD=change-this-password
PGADMIN_PORT=5050

# Frontend Development Helpers
VITE_BYPASS_AUTH=false
VITE_BYPASS_USER_EMAIL=developer@ila.dev
VITE_BYPASS_USER_NAME=Developer User
VITE_BYPASS_USER_ROLE=admin

# Production Database URL (for deployment)
# DATABASE_URL=postgresql://username:password@host:port/database

# API Configuration
# For development, point directly to backend
# For production with nginx proxy, use /api
VITE_API_BASE_URL=http://localhost:3001/api