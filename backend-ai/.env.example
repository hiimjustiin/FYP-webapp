# ILA AI Feedback Service Environment Variables

# Service Configuration
SERVICE_NAME=ila-ai-feedback
SERVICE_VERSION=1.0.0
ENVIRONMENT=development

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=2000
OPENAI_TIMEOUT=60

# Token Limits
MAX_INPUT_TOKENS=10000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ila_webapp
DB_POOL_MIN=2
DB_POOL_MAX=10

# Express Backend Integration
EXPRESS_BACKEND_URL=http://localhost:3001
EXPRESS_API_TIMEOUT=30

# Redis Cache Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=86400
CACHE_ENABLED=true

# AI Processing Configuration
MAX_RETRIES=3
RETRY_DELAY=5
PROCESSING_TIMEOUT=300

# Cost Tracking (GPT-4o pricing as of 2024)
COST_PER_1K_INPUT_TOKENS=0.0025
COST_PER_1K_OUTPUT_TOKENS=0.01

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
