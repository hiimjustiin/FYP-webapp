# =============================================================================
# PRODUCTION ENVIRONMENT TEMPLATE
# =============================================================================
# This template shows what variables are needed for production
# The actual .env.production file is created by GitHub Actions during deployment
# DO NOT commit .env.production to git!
# =============================================================================

# Database Configuration
POSTGRES_DB=ila_db
POSTGRES_USER=ila_user
POSTGRES_PASSWORD=<from-github-secret-POSTGRES_PASSWORD>
POSTGRES_PORT=5432

# Application Configuration
NODE_ENV=production
JWT_SECRET=<from-github-secret-JWT_SECRET>
CORS_ORIGIN=https://ila-analytics.rdc.nie.edu.sg

# Port Configuration
FRONTEND_PORT=80
BACKEND_PORT=3001

# Production Database URL
DATABASE_URL=postgresql://ila_user:<POSTGRES_PASSWORD>@postgres:5432/ila_db

# API Base URL (for frontend - MUST use HTTPS with domain after SSL setup!)
VITE_API_BASE_URL=https://ila-analytics.rdc.nie.edu.sg/api

# Frontend Production Settings
VITE_BYPASS_AUTH=false
